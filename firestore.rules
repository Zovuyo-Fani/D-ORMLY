rules_version = '2';

// =====================================================
// DORMLY – Firestore security rules
// Who can read / write what. These rules run on Google's
// servers, so they protect data even if someone bypasses
// the website and talks to Firebase directly.
// =====================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Admins are added by hand in the Firebase console:
    // create a document in the "admins" collection whose ID is the admin's user ID.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isLandlord() {
      return signedIn() &&
        exists(userDoc(request.auth.uid)) &&
        get(userDoc(request.auth.uid)).data.get('role', 'student') == 'landlord';
    }

    // ---------- users: each person can only see and edit their own profile ----------
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // People can only choose student or landlord when they sign up
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.role in ['student', 'landlord'];

      // Nobody can change their own role afterwards
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.get('role', 'student') == resource.data.get('role', 'student');

      allow delete: if false;
    }

    // ---------- properties: only signed-in people can browse; only the owner can change ----------
    match /properties/{propertyId} {
      allow read: if signedIn();

      // Landlords must have confirmed their email before publishing
      allow create: if isLandlord() &&
        request.auth.token.email_verified == true &&
        request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn() &&
        ((resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId) || isAdmin());

      allow delete: if signedIn() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ---------- chats: only the people in the conversation ----------
    match /chats/{chatId} {
      allow read, update, delete: if signedIn() &&
        request.auth.uid in resource.data.participants;

      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;

        allow update, delete: if false;
      }
    }

    // ---------- payment submissions: the student who sent it, and admins ----------
    match /paymentSubmissions/{submissionId} {
      allow read: if signedIn() &&
        (resource.data.studentId == request.auth.uid || isAdmin());

      allow create: if signedIn() &&
        request.auth.token.email_verified == true &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'pending_review';

      // Only admins can approve / reject a payment
      allow update, delete: if isAdmin();
    }

    // ---------- admins list: never readable from the website ----------
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // ---------- everything else is closed ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
